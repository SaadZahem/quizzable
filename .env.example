# Copy to .env and fill in real values. The .env file is gitignored.

# App secrets — generate with: openssl rand -hex 32
SECRET_KEY="replace-me"
STORAGE_SECRET="replace-me"

# Postgres credentials (used by docker-compose.prod.yml for both the db
# service and the app's DATABASE_URL). Generate a password with:
#   openssl rand -hex 24
POSTGRES_USER="quizzable"
POSTGRES_PASSWORD="replace-me"
POSTGRES_DB="quizzable"

# Optional: override the database connection directly (e.g. a managed Postgres).
# When unset, the app defaults to local SQLite (development).
# DATABASE_URL="postgres://user:password@host:5432/dbname"
